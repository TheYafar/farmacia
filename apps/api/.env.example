# Copia este archivo como .env y cambia TODOS los valores marcados con CAMBIAR.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://farmacia:CAMBIAR@localhost:5432/farmacia

# openssl rand -base64 48
JWT_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio_de_48_caracteres
ACCESS_TOKEN_MINUTOS=15
SESION_DIAS=7

# Dirección de la app web (en desarrollo, Vite)
CORS_ORIGINS=http://localhost:5173
# En desarrollo sin HTTPS: false. En producción: true
COOKIE_SECURE=false

UPLOAD_DIR=./uploads
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=15
NOTIFICADOR=log

# Solo para crear el primer usuario (npm run db:seed)
SEED_ADMIN_USUARIO=dueno
SEED_ADMIN_CLAVE=CAMBIAR_clave_de_al_menos_10
SEED_DEMO=false
