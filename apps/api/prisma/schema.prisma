// Modelo de datos del sistema de mostrador.
// Basado en la sección 9 del documento de planificación, ampliado con usuarios,
// sesiones, compras, autorizaciones y auditoría.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Personas y acceso ----------

enum Rol {
  CAJERO
  REGENTE
  ADMIN
}

model Usuario {
  id               String    @id @default(uuid()) @db.Uuid
  nombre           String
  usuario          String    @unique
  claveHash        String
  rol              Rol
  activo           Boolean   @default(true)
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  creadoEn         DateTime  @default(now())

  sesiones        Sesion[]
  ventas          Venta[]         @relation("CajeroVenta")
  autorizaciones  Autorizacion[]  @relation("RegenteAutoriza")
  solicitudes     Autorizacion[]  @relation("SolicitaAutorizacion")
  turnos          Turno[]         @relation("TurnoCajero")
  turnosRevisados Turno[]         @relation("TurnoRevisor")
  recipesCreados  Recipe[]        @relation("RecipeCreadoPor")
  recipesValidados Recipe[]       @relation("RecipeValidadoPor")
  tasas           TasaCambio[]
  compras         Compra[]
  auditoria       Auditoria[]
}

/// Una sesión por dispositivo. El token de renovación se guarda solo como hash.
model Sesion {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @db.Uuid
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  refreshHash String
  expira      DateTime
  revocadaEn  DateTime?
  ip          String?
  agente      String?
  creadaEn    DateTime  @default(now())

  @@index([usuarioId])
}

// ---------- Catálogo ----------

enum CategoriaRiesgo {
  NORMAL
  ANTIBIOTICO
  PSICOTROPICO
}

enum NivelPrecio {
  GENERICO
  NACIONAL
  MARCA
}

model PrincipioActivo {
  id        String          @id @default(uuid()) @db.Uuid
  nombre    String          @unique
  /// Familia para cruzar alergias, ej. "penicilinas", "aines".
  familia   String?
  riesgo    CategoriaRiesgo @default(NORMAL)
  /// Para qué sirve, en palabras simples (se muestra al resolver LASA).
  uso       String?

  productos Producto[]
  lasaA     ParLasa[]       @relation("LasaA")
  lasaB     ParLasa[]       @relation("LasaB")
}

/// Pares que se parecen al escribir o al pronunciar (Look-Alike, Sound-Alike).
model ParLasa {
  aId  String          @db.Uuid
  bId  String          @db.Uuid
  a    PrincipioActivo @relation("LasaA", fields: [aId], references: [id])
  b    PrincipioActivo @relation("LasaB", fields: [bId], references: [id])
  nota String?

  @@id([aId, bId])
}

model Producto {
  id                String          @id @default(uuid()) @db.Uuid
  codigoBarras      String?         @unique
  nombreComercial   String
  laboratorio       String
  principioActivoId String          @db.Uuid
  principioActivo   PrincipioActivo @relation(fields: [principioActivoId], references: [id])
  concentracion     String
  forma             String
  unidadesPorCaja   Int
  precioUsd         Decimal         @db.Decimal(12, 2)
  nivel             NivelPrecio
  requiereRecipe    Boolean         @default(false)
  /// Aviso de stock bajo cuando la existencia llega a este número (0 = sin aviso).
  stockMinimo       Int             @default(0)
  activo            Boolean         @default(true)
  actualizadoEn     DateTime        @updatedAt

  lotes      Lote[]
  lineas     VentaLinea[]
  esperas    SolicitudEspera[]
  compras    CompraLinea[]
  autorizaciones Autorizacion[]

  /// Búsqueda de bioequivalentes: misma molécula, concentración y forma.
  @@index([principioActivoId, concentracion, forma])
}

/// Existencia por lote. Se vende primero el que vence antes (FEFO).
model Lote {
  id             String   @id @default(uuid()) @db.Uuid
  productoId     String   @db.Uuid
  producto       Producto @relation(fields: [productoId], references: [id])
  numero         String
  vence          DateTime @db.Date
  stockLibre     Int
  stockReservado Int      @default(0)
  creadoEn       DateTime @default(now())

  lineas  VentaLinea[]
  esperas SolicitudEspera[]

  @@unique([productoId, numero])
  @@index([productoId, vence])
}

/// Factura de la droguería. Al guardarla se crean o suman lotes y se atiende la lista de espera.
model Compra {
  id            String        @id @default(uuid()) @db.Uuid
  proveedor     String
  numeroFactura String
  /// Cuentas por pagar: total de la factura, pagado y fecha de vencimiento del crédito.
  totalUsd      Decimal       @default(0) @db.Decimal(12, 2)
  pagadoUsd     Decimal       @default(0) @db.Decimal(12, 2)
  venceEn       DateTime?
  pagos         PagoProveedor[]
  creadaPorId   String        @db.Uuid
  creadaPor     Usuario       @relation(fields: [creadaPorId], references: [id])
  creadaEn      DateTime      @default(now())
  lineas        CompraLinea[]

  @@unique([proveedor, numeroFactura])
}

model CompraLinea {
  id          String   @id @default(uuid()) @db.Uuid
  compraId    String   @db.Uuid
  compra      Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId  String   @db.Uuid
  producto    Producto @relation(fields: [productoId], references: [id])
  numeroLote  String
  vence       DateTime @db.Date
  cantidad    Int
  factorVenta Int      @default(1)
  /// Costo por unidad de compra, en $. Sirve para la ganancia.
  costoUsd    Decimal  @default(0) @db.Decimal(12, 2)
}

// ---------- Pacientes y récipes ----------

model Paciente {
  cedula      String   @id
  nombre      String
  telefono    String
  alergias    String[]
  condiciones String[]
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  ventas         Venta[]
  recipes        Recipe[]
  esperas        SolicitudEspera[]
  autorizaciones Autorizacion[]
}

model Medico {
  id           String   @id @default(uuid()) @db.Uuid
  nombre       String
  especialidad String
  mpps         String?  @unique
  recipes      Recipe[]
}

enum EstadoRecipe {
  PENDIENTE
  VALIDADO
  RECHAZADO
}

model Recipe {
  id             String       @id @default(uuid()) @db.Uuid
  cedula         String?
  paciente       Paciente?    @relation(fields: [cedula], references: [cedula])
  medicoId       String?      @db.Uuid
  medico         Medico?      @relation(fields: [medicoId], references: [id])
  /// Ruta del archivo dentro del volumen privado. Nunca se sirve de forma pública.
  archivo        String
  tipoArchivo    String
  /// Lectura de la IA: [{ texto, confianza, candidatos: [principioActivoId] }]
  lecturaIa      Json?
  estado         EstadoRecipe @default(PENDIENTE)
  confirmados    Json?
  nota           String?
  creadoPorId    String       @db.Uuid
  creadoPor      Usuario      @relation("RecipeCreadoPor", fields: [creadoPorId], references: [id])
  validadoPorId  String?      @db.Uuid
  validadoPor    Usuario?     @relation("RecipeValidadoPor", fields: [validadoPorId], references: [id])
  validadoEn     DateTime?
  creadoEn       DateTime     @default(now())

  lineas VentaLinea[]

  @@index([estado, creadoEn])
}

enum EstadoAutorizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/// Permiso de un Regente para vender un producto delicado a un paciente.
/// El cajero lo pide (PENDIENTE) o el Regente lo da directo (APROBADA). Se usa una sola vez y vence.
model Autorizacion {
  id              String             @id @default(uuid()) @db.Uuid
  cedula          String
  paciente        Paciente           @relation(fields: [cedula], references: [cedula])
  productoId      String             @db.Uuid
  producto        Producto           @relation(fields: [productoId], references: [id])
  estado          EstadoAutorizacion @default(PENDIENTE)
  /// Qué necesita revisión: ALERGIA o CONTROLADO.
  razon           String?
  solicitadaPorId String?            @db.Uuid
  solicitadaPor   Usuario?           @relation("SolicitaAutorizacion", fields: [solicitadaPorId], references: [id])
  regenteId       String?            @db.Uuid
  regente         Usuario?           @relation("RegenteAutoriza", fields: [regenteId], references: [id])
  motivo          String?
  respondidaEn    DateTime?
  expira          DateTime?
  usadaEn         DateTime?
  creadaEn        DateTime           @default(now())

  lineas VentaLinea[]

  @@index([estado, creadaEn])
  @@index([cedula, productoId, estado])
}

// ---------- Ventas ----------

enum MetodoPago {
  PAGO_MOVIL
  PUNTO_DE_VENTA
  EFECTIVO_USD
  EFECTIVO_BS
}

enum EstadoVenta {
  COMPLETADA
  ANULADA
}

model Venta {
  id             String      @id @default(uuid()) @db.Uuid
  numero         Int         @default(autoincrement()) @unique
  cajeroId       String      @db.Uuid
  cajero         Usuario     @relation("CajeroVenta", fields: [cajeroId], references: [id])
  cedula         String?
  paciente       Paciente?   @relation(fields: [cedula], references: [cedula])
  totalUsd       Decimal     @db.Decimal(12, 2)
  /// Tasa usada en el momento de la venta: el monto en Bs no cambia aunque cambie la tasa después.
  tasa           Decimal     @db.Decimal(14, 4)
  totalBs        Decimal     @db.Decimal(16, 2)
  metodoPago     MetodoPago
  referenciaPago String?
  estado         EstadoVenta @default(COMPLETADA)
  creadaEn       DateTime    @default(now())
  /// Turno de caja en que se cobró. Vacío en cobros hechos fuera de la caja (ej. Pago Móvil de un encargo).
  turnoId        String?     @db.Uuid
  turno          Turno?      @relation(fields: [turnoId], references: [id])
  /// Vuelto entregado al cliente, en la moneda en que se dio.
  vueltoMoneda   Moneda?
  vueltoMonto    Decimal     @default(0) @db.Decimal(16, 2)
  /// Descuento a toda la venta (tercera edad, convenio…). El total ya lo trae restado.
  descuentoPct   Decimal     @default(0) @db.Decimal(5, 2)
  descuentoUsd   Decimal     @default(0) @db.Decimal(12, 2)
  descuentoMotivo String?
  devoluciones   Devolucion[]

  lineas  VentaLinea[]
  pagos   Pago[]
  esperas SolicitudEspera[]

  @@index([creadaEn])
  @@index([turnoId])
}

enum Moneda {
  USD
  BS
}

/// Una venta puede pagarse con varios métodos (ej. 5 $ en efectivo y el resto por Pago Móvil).
model Pago {
  id         String     @id @default(uuid()) @db.Uuid
  ventaId    String     @db.Uuid
  venta      Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodo     MetodoPago
  moneda     Moneda
  /// Monto en la moneda del método.
  monto      Decimal    @db.Decimal(16, 2)
  /// Equivalente en dólares con la tasa de la venta.
  montoUsd   Decimal    @db.Decimal(12, 2)
  referencia String?
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

/// Turno de caja de un cajero: se abre con un fondo y se cierra contando lo que hay.
model Turno {
  id            String      @id @default(uuid()) @db.Uuid
  cajeroId      String      @db.Uuid
  cajero        Usuario     @relation("TurnoCajero", fields: [cajeroId], references: [id])
  estado        EstadoTurno @default(ABIERTO)
  fondoUsd      Decimal     @default(0) @db.Decimal(12, 2)
  fondoBs       Decimal     @default(0) @db.Decimal(16, 2)
  abiertoEn     DateTime    @default(now())
  cerradoEn     DateTime?
  /// Al cerrar: lo que el sistema esperaba, lo que contó el cajero y la diferencia, por método de pago.
  esperado      Json?
  contado       Json?
  diferencia    Json?
  nota          String?
  revisadoPorId String?     @db.Uuid
  revisadoPor   Usuario?    @relation("TurnoRevisor", fields: [revisadoPorId], references: [id])
  revisadoEn    DateTime?

  ventas Venta[]

  @@index([cajeroId, estado])
  @@index([abiertoEn])
}

model VentaLinea {
  id             String        @id @default(uuid()) @db.Uuid
  ventaId        String        @db.Uuid
  venta          Venta         @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     String        @db.Uuid
  producto       Producto      @relation(fields: [productoId], references: [id])
  loteId         String        @db.Uuid
  lote           Lote          @relation(fields: [loteId], references: [id])
  cantidad       Int
  precioUsd      Decimal       @db.Decimal(12, 2)
  autorizacionId String?       @db.Uuid
  autorizacion   Autorizacion? @relation(fields: [autorizacionId], references: [id])
  recipeId       String?       @db.Uuid
  recipe         Recipe?       @relation(fields: [recipeId], references: [id])
  /// Unidades de esta línea que el cliente devolvió.
  devuelto       Int           @default(0)
}

// ---------- Lista de espera (sección 6 del documento) ----------

enum EstadoEspera {
  EN_ESPERA
  NOTIFICADO
  PAGADO_CUSTODIA
  ENTREGADO
  EXPIRADO
}

model SolicitudEspera {
  id                  String       @id @default(uuid()) @db.Uuid
  cedula              String
  paciente            Paciente     @relation(fields: [cedula], references: [cedula])
  productoId          String       @db.Uuid
  producto            Producto     @relation(fields: [productoId], references: [id])
  estado              EstadoEspera @default(EN_ESPERA)
  solicitadaEn        DateTime     @default(now())
  notificadaEn        DateTime?
  venceReserva        DateTime?
  /// Lote del que se separó la caja al llegar la mercancía.
  loteId              String?      @db.Uuid
  lote                Lote?        @relation(fields: [loteId], references: [id])
  referenciaPagoMovil String?
  gaveta              String?
  ventaId             String?      @db.Uuid
  venta               Venta?       @relation(fields: [ventaId], references: [id])
  cerradaEn           DateTime?

  @@index([productoId, estado, solicitadaEn])
}

// ---------- Tasa de cambio y auditoría ----------

model TasaCambio {
  id          String   @id @default(uuid()) @db.Uuid
  valor       Decimal  @db.Decimal(14, 4)
  fuente      String   @default("BCV")
  creadaPorId String   @db.Uuid
  creadaPor   Usuario  @relation(fields: [creadaPorId], references: [id])
  creadaEn    DateTime @default(now())

  @@index([creadaEn])
}

/// Registro de acciones sensibles: quién, qué, cuándo y desde dónde. Solo se agrega, nunca se edita.
model Auditoria {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String?  @db.Uuid
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  accion    String
  entidad   String
  entidadId String?
  datos     Json?
  ip        String?
  creadaEn  DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([creadaEn])
}

/// Pago a una droguería por una compra a crédito.
model PagoProveedor {
  id         String   @id @default(uuid()) @db.Uuid
  compraId   String   @db.Uuid
  compra     Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  montoUsd   Decimal  @db.Decimal(12, 2)
  metodo     String
  referencia String?
  usuarioId  String   @db.Uuid
  creadoEn   DateTime @default(now())
}

/// Cliente que compra al mayor: clínica, farmacia o empresa.
model ClienteEmpresa {
  id           String        @id @default(uuid()) @db.Uuid
  rif          String        @unique
  nombre       String
  telefono     String?
  limiteUsd    Decimal       @db.Decimal(12, 2)
  diasCredito  Int           @default(15)
  /// Descuento sobre el precio de detal: así sale su precio de mayor.
  descuentoPct Decimal       @default(10) @db.Decimal(5, 2)
  activo       Boolean       @default(true)
  creadoEn     DateTime      @default(now())
  pedidos      PedidoMayor[]
}

enum EstadoPedidoMayor {
  COTIZACION
  PEDIDO
  DESPACHADO
  ENTREGADO
  ANULADO
}

model PedidoMayor {
  id        String             @id @default(uuid()) @db.Uuid
  numero    Int                @default(autoincrement()) @unique
  clienteId String             @db.Uuid
  cliente   ClienteEmpresa     @relation(fields: [clienteId], references: [id])
  estado    EstadoPedidoMayor  @default(COTIZACION)
  totalUsd  Decimal            @db.Decimal(12, 2)
  pagadoUsd Decimal            @default(0) @db.Decimal(12, 2)
  venceEn   DateTime?
  creadoPorId String           @db.Uuid
  creadoEn  DateTime           @default(now())
  lineas    PedidoMayorLinea[]
  abonos    AbonoMayor[]

  @@index([clienteId, estado])
}

model PedidoMayorLinea {
  id         String      @id @default(uuid()) @db.Uuid
  pedidoId   String      @db.Uuid
  pedido     PedidoMayor @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId String      @db.Uuid
  cantidad   Int
  precioUsd  Decimal     @db.Decimal(12, 2)
}

model AbonoMayor {
  id         String      @id @default(uuid()) @db.Uuid
  pedidoId   String      @db.Uuid
  pedido     PedidoMayor @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  montoUsd   Decimal     @db.Decimal(12, 2)
  metodo     String
  referencia String?
  usuarioId  String      @db.Uuid
  creadoEn   DateTime    @default(now())
}

/// Registro de mensajes de WhatsApp enviados a clientes (recordatorios de recompra).
model MensajeWhatsapp {
  id         String   @id @default(uuid()) @db.Uuid
  cedula     String
  productoId String?  @db.Uuid
  tipo       String
  usuarioId  String   @db.Uuid
  creadoEn   DateTime @default(now())

  @@index([cedula, creadoEn])
}

/// Devolución de parte o de toda una venta. El reintegro sale de la caja de quien la hace.
model Devolucion {
  id        String     @id @default(uuid()) @db.Uuid
  ventaId   String     @db.Uuid
  venta     Venta      @relation(fields: [ventaId], references: [id])
  motivo    String
  montoUsd  Decimal    @db.Decimal(12, 2)
  metodo    MetodoPago
  /// Monto entregado al cliente, en la moneda del método.
  monto     Decimal    @db.Decimal(16, 2)
  turnoId   String?    @db.Uuid
  lineas    Json
  usuarioId String     @db.Uuid
  creadoEn  DateTime   @default(now())

  @@index([turnoId])
}

/// Corrección de inventario: merma, roto, vencido o conteo físico. Siempre con motivo.
model AjusteInventario {
  id        String   @id @default(uuid()) @db.Uuid
  loteId    String   @db.Uuid
  cantidad  Int
  motivo    String
  nota      String?
  usuarioId String   @db.Uuid
  creadoEn  DateTime @default(now())
}
