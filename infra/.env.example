# Copiar como infra/.env en el servidor. Este archivo NUNCA se sube a GitHub.

# Dominio de la farmacia (debe apuntar a la IP del VPS). Ej: mostrador.farmaciaavila.com
DOMINIO=CAMBIAR.ejemplo.com

# openssl rand -base64 32
DB_PASSWORD=CAMBIAR
# openssl rand -base64 48
JWT_SECRET=CAMBIAR

# Primer usuario del dueño (solo se usa una vez con: docker compose exec api node dist/prisma/seed.js)
SEED_ADMIN_USUARIO=dueno
SEED_ADMIN_CLAVE=CAMBIAR

NOTIFICADOR=log

# --- Solo para un servidor de PRUEBAS ---
# Carga catálogo de ejemplo y los usuarios «cajero» y «farmaceutico» con esta clave.
SEED_DEMO=false
SEED_DEMO_CLAVE=

# --- Solo en modo compartido (otro proyecto ya usa 80/443, ver docs/DESPLIEGUE.md) ---
# Puerto local donde escucha la farmacia; el servidor web del VPS le pasa las visitas.
PUERTO_LOCAL=8090
