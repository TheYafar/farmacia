# Modo normal: SITIO = el dominio, y Caddy obtiene y renueva solo el certificado HTTPS.
# Modo compartido (otro proyecto ya usa 80/443): SITIO = ":80" y el servidor web del VPS hace el HTTPS.
{
	servers {
		# Acepta la IP del cliente que informa el servidor web del VPS (red interna).
		trusted_proxies static private_ranges
	}
}

{$SITIO} {
	encode zstd gzip

	# Fotos de récipes de hasta 5 MB, más margen.
	request_body {
		max_size 6MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		# Es una app privada de la farmacia: que los buscadores no la muestren.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Fotos de los productos: no son datos privados y su nombre cambia con cada foto nueva,
	# así que el navegador las guarda y no las vuelve a pedir.
	handle /api/v1/fotos/* {
		reverse_proxy api:3000
	}

	handle /api/* {
		# Los datos (clientes, ventas) no se guardan en la memoria del navegador ni de intermediarios.
		header Cache-Control "no-store"
		reverse_proxy api:3000
	}

	# La app es de una sola página: cualquier ruta desconocida carga index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
