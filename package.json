{
  "name": "farmacia",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @farmacia/web",
    "dev:api": "npm run dev -w @farmacia/api",
    "build": "npm run build -w @farmacia/shared && npm run build -w @farmacia/api && npm run build -w @farmacia/web",
    "build:pages": "npm run build:pages -w @farmacia/demo",
    "test": "npm run build -w @farmacia/shared && npm test -w @farmacia/api",
    "dev:demo": "npm run dev -w @farmacia/demo"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "multer": "2.5.0",
    "qs": "6.17.1",
    "uuid": "11.1.1",
    "express": "4.22.3",
    "path-to-regexp@0.1": "0.1.13"
  }
}
